# SmartFeed AI - Environment Configuration Example
# Copy this file to .env and insert your optional API keys if desired.
# NOTE: SmartFeed AI works 100% offline with its rule-based advisory engine.
# No API keys are required to use all core features.

# Optional OpenAI API Key
OPENAI_API_KEY=

# Optional Anthropic Claude API Key
ANTHROPIC_API_KEY=

# SQLite Database Location Override (default is smartfeed.db in project root)
SMARTFEED_DB_PATH=smartfeed.db
